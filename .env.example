# Copy to .env (or export) as needed. All settings are optional for local development.
DATABASE_URL=dbname=ds_companies
# CONTROL_DATABASE_URL=dbname=ds_companies     # control plane (runs, artifacts, catalog)
# SERVING_DATABASE_URL=dbname=ds_companies     # serving data (gold.*, er.*)
DATA_PLATFORM_DATA_DIR=./data
DATA_PLATFORM_AUTH_MODE=dev                    # dev | api_key
DATA_PLATFORM_MIN_FREE_DISK_MB=500
# DATA_PLATFORM_EXTRA_SOURCES=my_pkg.adapter:MyAdapter
# Identify the platform to providers (Wikimedia asks for contact details in the User-Agent).
# DATA_PLATFORM_USER_AGENT="osm-companies-data-platform/1.0 (https://example.org; you@example.org)"
# Provider credentials (never in parameters or code): read via settings.secret("NAME")
# OpenCorporates: your own API token (free tokens exist for open-data / public-benefit use).
# DP_SECRET_OPENCORPORATES_API_TOKEN=
# Point adapters at mirrors / fixtures (tests use these; defaults are the official endpoints).
# GEONAMES_BASE_URL=https://download.geonames.org/export
# WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
# WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
# COMMONCRAWL_DATA_URL=https://data.commoncrawl.org
# GDELT_BASE_URL=https://data.gdeltproject.org/gdeltv2
# OPENCORPORATES_API_URL=https://api.opencorporates.com/v0.4
