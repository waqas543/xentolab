# Copy to .env (never commit .env).

# Hosted JS-rendering loader
LOAD_PAGE_URL=http://load-page
LOAD_PAGE_API_KEY=your-load-page-api-key

# Self-hosted scrape API (POST /v1/scrape, Bearer auth): used by the Google search engine
SCRAPE_API_URL=http://127.0.0.1:8000/v1/scrape
SCRAPE_API_KEY=your-scrape-api-key

# Optional
# OLLAMA_URL=http://localhost:11434       # local Qwen for company profiles (summary: in the job YAML)
# USER_AGENT=Mozilla/5.0 (compatible; XentoScraper/0.1; +https://xento.pk)
# LOG_LEVEL=INFO
# LOG_DIR=output/logs
